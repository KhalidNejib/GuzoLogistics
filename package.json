{
  "name": "ethio-logistics-v1",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev --filter=@ethio-logistics/api",
    "mobile": "turbo run dev --filter=mobile-rider --filter=@ethio-logistics/env --filter=@ethio-logistics/types",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.12.25",
      "js-cookie": "^3.0.7"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.39",
    "babel-preset-expo": "^12.0.0",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "turbo": "1.13.4",
    "typescript-eslint": "^8.58.1"
  }
}
