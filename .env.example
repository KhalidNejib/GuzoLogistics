# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Comma-separated list of browser origins allowed to call this API and
# connect via Socket.io (CORS). Required in production — the server logs an
# error and refuses to fall back to a wildcard origin if this is unset and
# NODE_ENV=production. Outside production, an unset value falls back to
# allowing any origin, for local dev convenience.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ─── Clerk (Authentication) ──────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → Your App → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_

# ─── MongoDB Atlas (Database) ─────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://admin:<password>@<cluster>.mongodb.net/ethio-logistics?appName=<cluster>

# ─── Redis Cloud (Live Tracking) ──────────────────────────────────────────────
# Get from: https://app.redislabs.com → Database → Configuration
REDIS_URL=redis://default:<password>@<host>:<port>

# ─── Cloudinary (Proof of Delivery Storage) ───────────────────────────────────
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Sentry (Error Tracking) ──────────────────────────────────────────────────
# Get from: https://sentry.io → Create Project → Integration keys
SENTRY_DSN=
VITE_SENTRY_DSN=

