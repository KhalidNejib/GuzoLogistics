# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Clerk (Authentication) ──────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → Your App → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_

# ─── MongoDB Atlas (Database) ─────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://admin:<password>@<cluster>.mongodb.net/ethio-logistics?appName=<cluster>

# ─── Redis Cloud (Live Tracking) ──────────────────────────────────────────────
# Get from: https://app.redislabs.com → Database → Configuration
REDIS_URL=redis://default:<password>@<host>:<port>
